{
  "name": "disqus-comments",
  "version": "1.0.0",
  "private": true,
  "description": "Disqus comment threads, SPA-aware",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./components": "./components/index.js",
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "quartz": {
    "name": "disqus-comments",
    "displayName": "Disqus Comments",
